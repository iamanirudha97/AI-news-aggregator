# Gemini API Key (obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Email SMTP Settings (Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SENDER_EMAIL=your_sending_gmail@gmail.com
# For Gmail, this must be a 16-character App Password, NOT your regular password
SENDER_PASSWORD=your_gmail_app_password_here
RECEIVER_EMAIL=your_receiving_email@example.com

# PostgreSQL Database Configuration
POSTGRES_DB=ai_news_db
POSTGRES_USER=ai_news_user
POSTGRES_PASSWORD=ai_news_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ai_news_user:ai_news_password@localhost:5432/ai_news_db
